---
interface Props {
    title: string;
}

const { title } = Astro.props;
---

<h3 class="page-title">{title}</h3>

<style>
    .page-title {
        font-weight: 600;
        margin: 1rem 0 0.4rem;
        font-size: var(--sl-text-sm);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--sl-color-accent-high);
        border: 0;
    }
</style>
