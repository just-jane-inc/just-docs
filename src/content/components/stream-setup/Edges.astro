---
import { edgeLine, type Box } from './geometry';
import type { StreamSetupEdge } from '../../schemas/stream-setup';

interface Props {
    edges: StreamSetupEdge[];
    boxes: Record<string, Box>;
    markerId: string;
}

const { edges, boxes, markerId } = Astro.props;

const lines = edges.flatMap((edge) => {
    const from = boxes[edge.from];
    const to = boxes[edge.to];

    return from && to ? [{ ...edgeLine(from, to), label: edge.label, dashed: edge.dashed }] : [];
});
---

{lines.length > 0 && (
    <svg class="edges" aria-hidden="true">
        <defs>
            <marker
                id={markerId}
                viewBox="0 0 10 10"
                refX="8"
                refY="5"
                markerWidth="5"
                markerHeight="5"
                orient="auto"
            >
                <path d="M 0 0 L 10 5 L 0 10 z" />
            </marker>
        </defs>

        {lines.map((line) => (
            <>
                <line
                    x1={`${line.x1}%`}
                    y1={`${line.y1}%`}
                    x2={`${line.x2}%`}
                    y2={`${line.y2}%`}
                    marker-end={`url(#${markerId})`}
                    stroke-dasharray={line.dashed ? '6 5' : undefined}
                />
                {line.label && (
                    <text x={`${line.midX}%`} y={`${line.midY}%`}>{line.label}</text>
                )}
            </>
        ))}
    </svg>
)}

<style>

    .edges {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
        z-index: 1;
    }

    .edges line {
        stroke: var(--sl-color-gray-3);
        stroke-width: 2;
    }

    .edges marker path {
        fill: var(--sl-color-gray-3);
    }

    .edges text {
        fill: var(--sl-color-white);
        stroke: var(--sl-color-black);
        stroke-width: 5;
        paint-order: stroke;
        font-size: 0.72rem;
        text-anchor: middle;
        dominant-baseline: middle;
    }
</style>
