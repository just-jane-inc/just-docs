---
interface Props {
    trail: Array<{ id: string, title: string }>;
}

const { trail } = Astro.props;
---

<nav class="crumbs" aria-label="Setup navigation">
    {trail.map((crumb, position) => (
        <>
            {position > 0 && <span class="separator" aria-hidden="true">/</span>}
            <button
                type="button"
                class="crumb"
                data-crumb={crumb.id}
                aria-current={position === trail.length - 1 ? 'true' : undefined}
                disabled={position === trail.length - 1}
            >{crumb.title}</button>
        </>
    ))}
</nav>

<style>
    .crumbs {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.35rem;
        margin-block-end: 0.6rem;
        font-size: var(--sl-text-sm);
    }

    .crumb {
        border: 0;
        background: none;
        padding: 0.1rem 0.3rem;
        border-radius: 0.25rem;
        color: var(--sl-color-accent-high);
        cursor: pointer;
        font: inherit;
    }

    .crumb:hover {
        background: var(--sl-color-gray-6);
    }

    .crumb[aria-current] {
        color: var(--sl-color-white);
        font-weight: 600;
        cursor: default;
    }

    .separator {
        color: var(--sl-color-gray-3);
    }
</style>
