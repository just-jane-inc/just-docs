---
---
<power-up-list />

<script>
    /**
     * @see https://api.bahms.org/swagger
     */
    interface PowerUpResponse {
        id: string
        title: string
        prompt: string
        bits: number
        'is-paused': boolean
        'background-color': string
        image: {
            'url-1x': string
            'url-2x': string
            'url-4x': string
        }
    }

    // Fetch the Power Ups during runtime, not during build time.
    const response = await fetch('https://api.bahms.org/v1/twitch/power-ups');
    const powerUps: PowerUpResponse[]|undefined = response.ok
        ? await response.json()
        : undefined;

    if (!Array.isArray(powerUps)) {
        throw new Error('Could not load Power Ups from API endpoint');
    }

    // Sort by Bits.
    powerUps.sort(({bits: a}, {bits: b}) => a - b)

    class PowerUp extends HTMLElement {
        connectedCallback() {
            const { title, description, cost, isPaused, icon, color } = this.dataset

            if (!title) {
                throw new Error('title is required')
            }

            if (!description) {
                throw new Error('description is required')
            }

            if (!cost) {
                throw new Error('cost is required')
            }

            if (!icon) {
                throw new Error('icon is required')
            }

            if (!color) {
                throw new Error('color is required')
            }

            this.style.setProperty('--power-up-color', color)

            if (isPaused) {
                this.classList.add('paused');
            }

            const heading = document.createElement('h2');
            heading.innerText = title

            this.append(heading)

            const figure = document.createElement('figure');
            if (icon) {
                const image = document.createElement('img')
                image.src = icon;
                image.alt = title;

                figure.append(image);
            }

            const caption = document.createElement('caption');
            caption.innerText = `${cost} bits`;
            figure.append(caption)
            this.append(figure)

            const paragraph = document.createElement('p');
            paragraph.innerText = description;
            this.append(paragraph);
        }
    }

    class PowerUpList extends HTMLElement {
        connectedCallback() {
            for (const item of powerUps ?? []) {
                const {
                    id,
                    title,
                    prompt,
                    bits,
                    'is-paused': isPaused,
                    'background-color': color,
                    image: {
                        'url-4x': imageUrl
                    }
                } = item;

                const powerUp = document.createElement('power-up');
                powerUp.id = `pu-${id}`;
                powerUp.title = title;

                powerUp.dataset.title = title;
                powerUp.dataset.cost = `${bits}`
                powerUp.dataset.description = prompt;
                powerUp.dataset.isPaused = isPaused ? 'paused' : '';
                powerUp.dataset.color = color;
                powerUp.dataset.icon = imageUrl;

                this.append(powerUp);
            }
        }
    }

    // Initialize the components if the API produced a valid response.
    if (powerUps.length > 0) {
        customElements.define('power-up-list', PowerUpList);
        customElements.define('power-up', PowerUp);
    }
</script>

<style>
    power-up-list {
        display: flex;
        flex-direction: column;
        margin-block: 2em;
        gap: 1em;

        power-up {
            --power-up-color: rgb(100, 100, 100);
            --power-up-alpha: 0.3;
            --power-up-icon-alpha: 0.6;
            --power-up-icon-width: 112px;

            &.paused {
                opacity: .3;
            }

            &:hover {
                --power-up-alpha: 0.6;
                --power-up-icon-alpha: 1;
            }

            display: block;
            position: relative;
            min-height: 190px;

            margin: 0;
            background: color(
                    from var(--power-up-color)
                    srgb
                    r g b / var(--power-up-alpha)
            );
            padding: 1em;
            border-radius: 0.5em;
            border: 0.2em solid var(--power-up-color);

            h2 {
                font-size: 1.6em;
            }

            p {
                margin-right: calc(var(--power-up-icon-width) + 2em)
            }

            figure {
                position: absolute;
                right: 1em;
                top: 1em;
                margin: 0;
                width: var(--power-up-icon-width);

                img {
                    width: 100%;
                    opacity: var(--power-up-icon-alpha);
                }

                caption {
                    display: block;
                    font-weight: 700;
                    background: rgba(100, 100, 100, 0.6);

                    &::before {
                        display: inline-block;
                        content: '';
                        width: 1em;
                        height: 1em;
                        margin-right: 0.5em;
                        background-image: url('https://dev.twitch.tv/marketing-assets/images/bits-in-extensions/diamond.png');
                        background-size: contain;
                        background-repeat: no-repeat;
                        background-position: center;
                        vertical-align: -0.01em;
                    }
                }
            }
        }
    }
</style>